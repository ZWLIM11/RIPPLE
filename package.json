{
  "name": "pass-detective-prototype",
  "private": true,
  "scripts": {
    "test": "node scripts/build-cloudflare.mjs && node --test tests/*.test.mjs",
    "start": "node server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check:cloudflare": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "wrangler": "^4.151.2"
  }
}
